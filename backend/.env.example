# Examora backend environment — copy to .env and fill in values

APP_NAME=Examora API
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=true

# PostgreSQL 17 (local) — Neon also works for cloud
# Replace YOUR_PASSWORD with your postgres user password
DATABASE_URL=postgresql+psycopg2://postgres:YOUR_PASSWORD@127.0.0.1:5432/examora

# Comma-separated origins, or * for local development
CORS_ORIGINS=*

# Firebase Admin (Phase 1)
FIREBASE_PROJECT_ID=examora-de022
# Download from Firebase Console → Project settings → Service accounts → Generate new private key
FIREBASE_CREDENTIALS_PATH=firebase-service-account.json

# Cloudflare R2 (Phase 2)
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=examora-notes
# R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com

# Phase 3 — keep cheap while developing (1 chunk). Raise NOTE_AI_MAX_CHUNKS (e.g. 20) for full PDF.
# Upload stores PDF only; AI/OCR runs when user creates a practice paper (Phase 4).
NOTE_AI_PROVIDER=openai
NOTE_AUTO_PROCESS=false
NOTE_AI_MAX_INPUT_CHARS=12000
NOTE_AI_MAX_OUTPUT_TOKENS=2500
NOTE_AI_CHUNK_OVERLAP=200
NOTE_AI_MAX_CHUNKS=1
# Required when NOTE_AI_PROVIDER=openai — https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Phase 3b — Google Cloud Vision OCR (handwritten / scanned PDFs)
# Download service account JSON; never commit it
GCP_VISION_CREDENTIALS_PATH=gcp-vision-service-account.json
OCR_PROVIDER=google_vision
OCR_MIN_TEXT_CHARS=100
OCR_MAX_PAGES=20

# Phase 4 — paper generation (keep small while developing)
PAPER_MONTHLY_CREATE_LIMIT=4
PAPER_MAX_PAGES=20
PAPER_SIZE_RATIO=0.3
PAPER_MIN_QUESTIONS=5
PAPER_MAX_QUESTIONS=15
PAPER_COOLDOWN_DAYS=14
PAPER_COOLDOWN_GENERATIONS=2
PAPER_GENERATE_UNIQUE_TARGET=12
PAPER_GENERATE_VARIANTS_PER_CONCEPT=2
