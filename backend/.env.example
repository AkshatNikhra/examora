# Examora backend environment — copy to .env and fill in values

APP_NAME=Examora API
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=true

# PostgreSQL (Neon or local)
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/examora

# Comma-separated origins, or * for local development
CORS_ORIGINS=*

# Phase 1+
# OPENAI_API_KEY=
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=
# FIREBASE_PROJECT_ID=
